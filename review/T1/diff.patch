+
+_subprocess_run_real = pr.subprocess.run
+
+
+def subprocess_run_espiao(cmd, *a, **kw):
+    if isinstance(cmd, (list, tuple)):
+        comandos_ffmpeg.append(list(cmd))
+    return _subprocess_run_real(cmd, *a, **kw)

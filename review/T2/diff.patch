+
+def test_run_subtitles_callback_delegation():
+    """Test run_subtitles delegates to callback action."""
+    called = []
+
+    def dummy_action(val):
+        called.append(val)
+        return "subs_result"
+
+    res = run_subtitles(dummy_action, "test_val")
